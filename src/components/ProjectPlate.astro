---
import type { CollectionEntry } from 'astro:content'

import type { Lang } from '@/i18n/ui'
import { toRoman, useTranslations } from '@/i18n/utils'
import { projectUrl } from '@/lib/projects'

interface Props {
  project: CollectionEntry<'projects'>
  index: number
  lang: Lang
}

const { project, index, lang } = Astro.props
const t = useTranslations(lang)
const { title, summary, stack, year, emblem } = project.data
---

<article
  data-tilt
  data-reveal-scroll
  class="group relative flex flex-col border-[1.5px] border-tinta [transform-style:preserve-3d]"
>
  <div class="relative aspect-[16/10] overflow-hidden border-b-[1.5px] border-tinta">
    {emblem ? (
      <div
        data-engrave={emblem}
        data-paper="claro"
        aria-hidden="true"
        class="size-full bg-papel-claro"
      ></div>
    ) : (
      <div class="rayado size-full bg-papel-claro"></div>
    )}
    <span class="absolute top-4 left-4 border-[1.5px] border-tinta bg-papel-claro px-3 py-1.5 font-mono text-xs tracking-[0.2em] uppercase">
      {`${t('projects.plate')} ${toRoman(index + 1)}`}
    </span>
  </div>
  <div class="flex flex-1 flex-col gap-3 bg-papel-claro p-6">
    <p class="font-mono text-xs text-grafito">{year}</p>
    <h3 class="font-display text-[27px] leading-tight">
      <!-- El enlace cubre toda la lámina con ::after, sin anidar elementos interactivos -->
      <a href={projectUrl(project, lang)} class="after:absolute after:inset-0">
        {title}
      </a>
    </h3>
    <p class="leading-relaxed text-tinta-suave">{summary}</p>
    <p class="font-mono text-xs leading-relaxed text-cobalto">{stack.join(' · ')}</p>
    <p class="mt-auto pt-3 font-mono text-sm group-hover:text-cobalto" aria-hidden="true">
      {t('projects.case')} →
    </p>
  </div>
</article>
