---
import { certificationsByIssuer, formatMonthYear, inProgress } from '@/data/certifications'
import { experience } from '@/data/experience'
import { localize } from '@/data/localized'
import { profile } from '@/data/profile'
import type { Lang } from '@/i18n/ui'
import { useTranslations } from '@/i18n/utils'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang)
---

<section
  id="experiencia"
  class="container-page scroll-mt-8 border-t-[1.5px] border-tinta py-20"
  aria-labelledby="experiencia-titulo"
>
  <div class="flex flex-wrap items-baseline justify-between gap-4">
    <h2 id="experiencia-titulo" data-reveal-scroll class="font-display text-5xl sm:text-6xl">
      {t('experience.title')}
    </h2>
    <p data-reveal-scroll class="font-mono text-[13px] tracking-[0.2em] uppercase">
      {t('experience.subtitle')}
    </p>
  </div>

  <!--
    Un solo registro con las mismas tres columnas (fecha · lugar y rol · detalle) para
    la trayectoria y la formación: todo queda alineado al mismo nivel.
  -->
  {[
    {
      title: t('experience.work'),
      rows: experience.map((item) => ({
        period: localize(item.period, lang),
        place: item.organization,
        role: localize(item.role, lang),
        detail: localize(item.description, lang),
        tags: item.tags.map((tag) => localize(tag, lang)),
      })),
    },
    {
      title: t('experience.education'),
      rows: profile.education.map((item) => ({
        period: localize(item.period, lang),
        place: item.institution,
        role: localize(item.degree, lang),
        detail: '',
        tags: [] as string[],
      })),
    },
  ].map((group) => (
    <div class="mt-14">
      <h3
        data-reveal-scroll
        class="border-b-[1.5px] border-tinta pb-3 font-mono text-[13px] tracking-[0.2em] uppercase"
      >
        {group.title}
      </h3>
      <ol>
        {group.rows.map((row) => (
          <li
            data-reveal-scroll
            class="grid gap-3 border-b-[1.5px] border-rejilla py-7 md:grid-cols-[11rem_minmax(0,1fr)_minmax(0,1.4fr)] md:gap-10"
          >
            <p class="font-mono text-sm text-grafito md:pt-2">{row.period}</p>
            <div class="flex flex-col gap-1">
              <p class="font-display text-3xl leading-tight">{row.place}</p>
              <p class="font-medium text-cobalto">{row.role}</p>
            </div>
            <div class="flex flex-col gap-3 md:pt-1.5">
              {row.detail && <p class="leading-relaxed text-tinta-suave">{row.detail}</p>}
              {row.tags.length > 0 && (
                <ul class="flex flex-wrap gap-2 font-mono text-xs">
                  {row.tags.map((tag) => (
                    <li class="border-[1.5px] border-tinta px-2.5 py-1">{tag}</li>
                  ))}
                </ul>
              )}
            </div>
          </li>
        ))}
      </ol>
    </div>
  ))}

  <!-- Certificaciones: una ficha por institución, todas de la misma altura -->
  <div class="mt-14">
    <h3
      data-reveal-scroll
      class="border-b-[1.5px] border-tinta pb-3 font-mono text-[13px] tracking-[0.2em] uppercase"
    >
      {t('experience.certifications')}
    </h3>
    <ul class="mt-8 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
      {certificationsByIssuer().map((group) => (
        <li
          data-reveal-scroll
          class="flex flex-col gap-5 border-[1.5px] border-tinta bg-papel-claro p-6"
        >
          <p class="font-display text-2xl leading-tight">{group.issuer}</p>
          <ul class="flex flex-col gap-3 border-t-[1.5px] border-rejilla pt-4">
            {group.items.map((cert) => (
              <li class="flex items-baseline justify-between gap-4">
                <span class="font-medium">
                  {cert.name}
                  {cert.note && (
                    <span class="font-normal text-tinta-suave"> · {localize(cert.note, lang)}</span>
                  )}
                </span>
                <span class="shrink-0 font-mono text-sm text-grafito">
                  {formatMonthYear(cert.date, lang)}
                </span>
              </li>
            ))}
          </ul>
        </li>
      ))}
      <li
        data-reveal-scroll
        class="flex flex-col gap-5 border-[1.5px] border-dashed border-cobalto p-6"
      >
        <p class="font-display text-2xl leading-tight text-cobalto">{t('experience.inProgress')}</p>
        <ul class="flex flex-col gap-3 border-t-[1.5px] border-rejilla pt-4">
          {inProgress.map((course) => (
            <li>
              <span class="font-medium">{course.name}</span>
              <span class="text-tinta-suave"> · {course.provider}</span>
            </li>
          ))}
        </ul>
      </li>
    </ul>
  </div>
</section>
