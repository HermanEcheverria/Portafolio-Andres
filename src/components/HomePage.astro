---
import { getCollection } from 'astro:content'

import ExperienceSection from '@/components/ExperienceSection.astro'
import Hero from '@/components/Hero.astro'
import ProjectPlate from '@/components/ProjectPlate.astro'
import SkillsSection from '@/components/SkillsSection.astro'
import WaveDivider from '@/components/WaveDivider.astro'
import type { Lang } from '@/i18n/ui'
import { useTranslations } from '@/i18n/utils'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { profile } from '@/data/profile'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang)

const projects = (
  await getCollection(
    'projects',
    ({ id, data }) => id.startsWith(`${lang}/`) && (import.meta.env.DEV || !data.draft),
  )
).sort((a, b) => a.data.order - b.data.order)
---

<BaseLayout>
  <Hero lang={lang} />
  <WaveDivider />

  <section id="laminas" class="container-page scroll-mt-8 py-14" aria-labelledby="laminas-titulo">
    <div class="flex flex-wrap items-baseline justify-between gap-4">
      <h2 id="laminas-titulo" data-reveal-scroll class="font-display text-5xl sm:text-6xl">
        {t('projects.title')}
      </h2>
      <p data-reveal-scroll class="font-mono text-[13px]">
        {t('projects.subtitle')}
      </p>
    </div>
    <div class="mt-10 grid gap-7 md:grid-cols-2 lg:grid-cols-3">
      {projects.map((project, index) => (
        <ProjectPlate project={project} index={index} lang={lang} />
      ))}
    </div>
  </section>

  <ExperienceSection lang={lang} />
  <SkillsSection lang={lang} />

  <section
    id="sobre-mi"
    class="container-page grid scroll-mt-8 gap-8 border-t-[1.5px] border-tinta py-20 md:grid-cols-[1fr_1.4fr]"
    aria-labelledby="sobre-mi-titulo"
  >
    <h2 id="sobre-mi-titulo" data-reveal-scroll class="font-display text-5xl">
      {t('about.title')}
    </h2>
    <div class="flex flex-col gap-5 text-xl leading-relaxed">
      <p data-reveal-scroll>{t('about.p1')}</p>
      <p data-reveal-scroll>{t('about.p2')}</p>
      <p data-reveal-scroll class="text-tinta-suave italic">
        {t('about.p3')}
      </p>
    </div>
  </section>

  <section
    id="contacto"
    class="container-page scroll-mt-8 border-t-[1.5px] border-tinta py-20"
    aria-labelledby="contacto-titulo"
  >
    <h2
      id="contacto-titulo"
      data-reveal-scroll
      class="sombra-impresa font-display text-[clamp(3rem,7vw,6rem)] leading-none"
    >
      {t('contact.title')}
    </h2>
    <p data-reveal-scroll class="mt-6 max-w-2xl text-xl leading-relaxed">
      {t('contact.body')}
    </p>
    <p data-reveal-scroll class="mt-8 font-mono text-lg">
      <a
        href={`mailto:${profile.email}`}
        class="border-b-[1.5px] border-tinta pb-1 break-all hover:text-cobalto"
      >
        {profile.email}
      </a>
    </p>
  </section>
</BaseLayout>
