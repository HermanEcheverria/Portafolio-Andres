---
/**
 * Pequeñas ilustraciones en grabado: contorno en tinta y sombra con rayado.
 * Cada una tiene su propio id de patrón para no chocar si se repiten en la página.
 */
import type { SkillGroup } from '@/data/skills'

interface Props {
  name: SkillGroup['icon']
}

const { name } = Astro.props
const id = `rayado-${name}`
---

<svg viewBox="0 0 160 120" width="160" height="120" aria-hidden="true" class="text-tinta">
  <defs>
    <pattern
      id={id}
      width="5"
      height="5"
      patternUnits="userSpaceOnUse"
      patternTransform="rotate(45)"
    >
      <rect width="5" height="1.3" fill="currentColor"></rect>
    </pattern>
  </defs>
  <g fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round">
    {name === 'browser' && (
      <>
        <rect x="30" y="30" width="104" height="72" fill={`url(#${id})`} stroke="none" />
        <rect x="22" y="22" width="104" height="72" fill="var(--color-papel-claro)" />
        <path d="M22 36 H126" />
        <circle cx="31" cy="29" r="2.5" fill="currentColor" />
        <circle cx="40" cy="29" r="2.5" fill="currentColor" />
        <path d="M36 52 H76 M36 62 H100 M36 72 H88" stroke-width="1.5" />
        <rect x="84" y="46" width="28" height="12" stroke="var(--color-cobalto)" />
      </>
    )}
    {name === 'database' && (
      <>
        <path d="M44 32 V88 A36 11 0 0 0 116 88 V32" fill="var(--color-papel-claro)" />
        <path d="M96 40 V96 A36 11 0 0 0 116 88 V32" fill={`url(#${id})`} stroke="none" />
        <path d="M44 32 V88 A36 11 0 0 0 116 88 V32" />
        <ellipse cx="80" cy="32" rx="36" ry="11" fill="var(--color-papel-claro)" />
        <path d="M44 51 A36 11 0 0 0 116 51 M44 70 A36 11 0 0 0 116 70" />
        <circle cx="104" cy="32" r="3" fill="var(--color-cobalto)" stroke="none" />
      </>
    )}
    {name === 'sheet' && (
      <>
        <rect x="42" y="28" width="84" height="78" fill={`url(#${id})`} stroke="none" />
        <rect x="34" y="20" width="84" height="78" fill="var(--color-papel-claro)" />
        <path d="M34 38 H118 M34 56 H118 M34 74 H118 M62 20 V98 M90 20 V98" stroke-width="1.5" />
        <path d="M100 86 L 132 54 M122 54 H132 V64" stroke="var(--color-cobalto)" />
      </>
    )}
    {name === 'container' && (
      <>
        <path d="M80 20 L124 42 L80 64 L36 42 Z" fill="var(--color-papel-claro)" />
        <path d="M36 42 V86 L80 108 V64 Z" fill="var(--color-papel-claro)" />
        <path d="M124 42 V86 L80 108 V64 Z" fill={`url(#${id})`} />
        <path d="M50 56 V88 M62 62 V94" stroke-width="1.5" />
        <path d="M80 20 L124 42 L80 64 L36 42 Z" />
        <path d="M60 32 L104 54" stroke="var(--color-cobalto)" />
      </>
    )}
  </g>
</svg>
