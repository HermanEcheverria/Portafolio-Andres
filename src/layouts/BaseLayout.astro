---
import { Font } from 'astro:assets'

import CommandPalette from '@/components/CommandPalette.astro'
import SiteFooter from '@/components/SiteFooter.astro'
import SiteHeader from '@/components/SiteHeader.astro'
import Terminal from '@/components/Terminal.astro'
import { getLang, localizedPath, useTranslations } from '@/i18n/utils'
import '@/styles/global.css'

interface Props {
  title?: string
  description?: string
  /** Ruta sin idioma ("/", "/proyectos/x"): enlaza la misma página en el otro idioma. */
  path?: string
  /** Imagen para compartir (Open Graph), relativa al sitio. */
  image?: string
  /** false si la página no existe en el otro idioma: no se anuncia la traducción. */
  translated?: boolean
  /** false para páginas como la 404: sin canonical ni hreflang, y fuera de buscadores. */
  indexable?: boolean
}

const lang = getLang(Astro.currentLocale)
const t = useTranslations(lang)
const {
  title = t('meta.title'),
  description = t('meta.description'),
  path = '/',
  image = lang === 'es' ? '/og.png' : '/og-en.png',
  translated = true,
  indexable = true,
} = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site)
const alternates = (translated ? (['es', 'en'] as const) : [lang]).map((l) => ({
  lang: l,
  href: new URL(localizedPath(l, path), Astro.site).toString(),
}))
---

<!doctype html>
<html lang={lang === 'es' ? 'es-GT' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {indexable ? (
      <>
        <link rel="canonical" href={canonical} />
        {alternates.map((a) => (
          <link rel="alternate" hreflang={a.lang} href={a.href} />
        ))}
      </>
    ) : (
      <meta name="robots" content="noindex" />
    )}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#ece7dc" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:locale" content={lang === 'es' ? 'es_GT' : 'en_US'} />
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-young-serif" preload />
    {/* Solo se precarga lo que se ve al abrir; el resto llega después sin bloquear */}
    <Font cssVariable="--font-plex-sans" preload={[{ weight: 400, style: 'normal' }]} />
    <Font cssVariable="--font-plex-mono" />
  </head>
  <body class="min-h-dvh">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-tinta focus:px-4 focus:py-2 focus:text-papel"
    >
      {t('nav.skip')}
    </a>
    <SiteHeader lang={lang} path={translated ? path : '/'} />
    <main id="contenido">
      <slot />
    </main>
    <SiteFooter lang={lang} />
    <CommandPalette lang={lang} path={translated ? path : '/'} />
    <Terminal lang={lang} path={translated ? path : '/'} />
    <script>
      import { initMotion } from '@/scripts/motion'
      initMotion()
    </script>
  </body>
</html>
